# ==============================================================================
# RAAS~RANG GARBA NIGHTS 2026 — ENVIRONMENT CONFIGURATION
# Set these variables in Cloudflare Dashboard: Workers & Pages > Your Project > Settings > Variables and Secrets
# Or create a .dev.vars file locally for wrangler pages dev
# ==============================================================================

# 1. Supabase Postgres Configuration (Backend Only)
# Found in Supabase Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key

# 2. Administrative & Gate Volunteer Authentication Keys
# Used in request header 'x-api-key' for verification, gate check-in, and reports
ADMIN_API_KEY=rrg_admin_secret_key_change_in_production
VOLUNTEER_API_KEY=rrg_volunteer_desk_key_2026

# 3. Resend Email Delivery (Free Tier)
# Found at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Raas~Rang 2026 <tickets@yourdomain.com>

# 4. Cloudflare Turnstile Bot Protection (Free Tier)
# Found in Cloudflare Dashboard > Turnstile
TURNSTILE_SECRET=0x4AAAAAA...your_turnstile_secret_key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...your_turnstile_site_key
